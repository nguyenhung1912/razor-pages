@page "/signup"
@model razor_pages.Pages.Register.IndexModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="card-title text-center text-primary fw-bold mb-4">Sign Up</h2>
                
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="User.Username" class="form-label fw-semibold"></label>
                        <input type="text" asp-for="User.Username" class="form-control"
                               placeholder="Nhập tên đăng nhập..." />
                        <span asp-validation-for="User.Username" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="User.Email" class="form-label fw-semibold"></label>
                        <input type="text" asp-for="User.Email" class="form-control"
                               placeholder="Nhập email của bạn..." />
                        <span asp-validation-for="User.Email" class="text-danger small"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="User.Password" class="form-label fw-semibold"></label>
                        <input type="password" asp-for="User.Password" class="form-control"
                               placeholder="Nhập mật khẩu..." />
                        <span asp-validation-for="User.Password" class="text-danger small"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Đăng ký</button>
                </form>
            </div>
        </div>
    </div>
</div>