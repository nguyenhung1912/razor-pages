@page "{id:int}"
@model razor_pages.Pages.Products.DetailsModel

<h2>Chi tiết sản phẩm</h2>

@if (Model.Product != null)
{
    <p><strong>ID:</strong> @Model.Product.Id</p>
    <p><strong>Tên:</strong> @Model.Product.Name</p>
    <p><strong>Mô tả:</strong> @Model.Product.Description</p>
    <p><strong>Giá:</strong> @Model.Product.Price$</p>
}
else
{
    <p>Sản phẩm không tồn tại.</p>
}

<a asp-page="List">Quay lại danh sách</a>