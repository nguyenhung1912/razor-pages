@page
@model razor_pages.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Product Management";
}

<h1 class="mb-4">Product Management</h1>

<div class="d-flex justify-content-between mb-4">
    <form method="get" class="w-50">
        <div class="input-group">
            <input type="text" asp-for="SearchKeyWord" class="form-control" placeholder="Tìm kiếm sản phẩm...">
                <button type="submit" class="btn btn-dark">Search</button>
            </div>
        </form>
        <a asp-page="./Create" class="btn btn-success">Thêm Sản Phẩm Mới</a>
    </div>

    <h3 class="mb-3">Danh sách sản phẩm</h3>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình Ảnh</th>
                <th>Tên</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Products != null && Model.Products.Count > 0)
            {
                foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" width="50" height="50" style="object-fit:cover" />
                            }
                        </td>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td class="text-success fw-bold">@product.Price.ToString("N0") VNĐ</td>
                        <td class="text-center">
                            <a asp-page="./Index" asp-route-id="@product.Id" class="btn btn-sm btn-info">Chi tiết</a>
                            <a asp-page="./Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-page-handler="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">Không có sản phẩm nào!</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.SelectedProduct != null)
    {
        <div class="card bg-light mb-4">
            <div class="card-body">
                <h4>Chi tiết sản phẩm</h4>
                <p><strong>ID:</strong> @Model.SelectedProduct.Id</p>
                <p><strong>Name:</strong> @Model.SelectedProduct.Name</p>
                <p><strong>Price:</strong> @Model.SelectedProduct.Price.ToString("N0") VNĐ</p>
                <p><strong>Description:</strong> @Model.SelectedProduct.Description</p>
            </div>
        </div>
    }